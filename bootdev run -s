
def total_words(text):
    words = text.split()
    return len(words)



def get_num_chars(chars):
    book_count = {

    }
    
    for letter in chars:
        lower_case = letter.lower()
        if lower_case in book_count:
            book_count[lower_case] = book_count[lower_case] + 1
        else:
            book_count[lower_case] = 1
    return book_count
        

